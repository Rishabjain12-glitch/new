def _p(pattern):
    return re.compile(pattern, re.I | re.S)

def clean_text(x):
    if pd.isna(x):
        return ""
    return re.sub(r"\s+", " ", str(x).replace("\u00a0", " ")).strip()

def to_num(x):
    if x is None or pd.isna(x):
        return np.nan
    m = re.search(r"-?[\d,]+(?:\.\d+)?", str(x))
    return float(m.group().replace(",", "")) if m else np.nan

def parse_date(x, fallback=pd.NaT):
    if x is None or pd.isna(x) or not str(x).strip():
        return fallback
    s = str(x).strip().replace("/", "-").replace(".", "-")
    for fmt in (
        "%d-%m-%Y", "%d-%m-%y",
        "%d%b%Y", "%d%b%y",
        "%d-%b-%Y", "%d-%b-%y",
        "%d-%B-%Y",
        "%Y-%m-%d",
        "%d %b %Y",
        "%b %d %Y",
        "%d%m%Y",
    ):
        try:
            return pd.Timestamp(datetime.strptime(s, fmt)).normalize()
        except ValueError:
            pass
    z = pd.to_datetime(s, errors="coerce", dayfirst=True)
    return z.normalize() if pd.notna(z) else fallback

def pick_column(df, candidates, required=True):
    lower = {str(c).lower(): c for c in df.columns}
    for c in candidates:
        if c.lower() in lower:
            return lower[c.lower()]
    if required:
        raise ValueError(f"Missing one of {candidates}. Available: {list(df.columns)}")
    return None

def canon(s):
    s = re.sub(r"[^A-Z0-9]+", "", str(s).upper())
    return ALIASES.get(s, s)

def norm_fields(d):
    d = {re.sub(r"^rx_", "", k).lower(): clean_text(v) for k, v in d.items() if v not in (None, "")}
    # CHANGE: expanded alias pairs to fix fund_balance / securities_balance
    # capture for BSE and other patterns that don't use rx_ prefix style
    alias_pairs = {
        "date2": "date",
        "ac_no": "acno",
        "ac_masked": "acmasked",
        "pledgee_ac": "pledgeeac",
        "fund_bal": "fundbal",
        "fund_balance": "fundbal",          # CHANGE: added
        "sec_bal": "secbal",
        "securities_balance": "secbal",      # CHANGE: added
        "nse_fo": "nsefo",
        "led_bal": "ledbal",
        "buy_val": "buyval",
        "sell_val": "sellval",
        "buy_qty": "buyqty",
        "sell_qty": "sellqty",
        "memcode": "membercode",
        "dp_id": "dpid",
        "client_id": "parsed_client_id",
        "broker_name": "broker_name",
        "eq_value": "eqvalue",              # CHANGE: added
        "fno_value": "fnovalue",            # CHANGE: added
        "currency_value": "currencyvalue",  # CHANGE: added
    }
    for a, b in alias_pairs.items():
        if a in d and b not in d:
            d[b] = d[a]
    return d

def val(f, *keys):
    for k in keys:
        z = f.get(k)
        if z not in (None, "") and not pd.isna(z):
            return z
    return np.nan

def build_rule_index(rules):
    out = []
    for family, items in rules.items():
        for label, pat in items:
            out.append((str(family).upper(), str(label), canon(label), pat))
    return out

def classify(text, rule_index):
    winning = None
    winning_fields = None
    hit_labels = []
    for family, label, key, pat in rule_index:
        m = pat.search(text)
        if m:
            hit_labels.append(f"{family}_{label}")
            if winning is None:
                winning = (family, label)
                winning_fields = m.groupdict()
    if winning is None:
        return "UNCATEGORISED", "", {}, []
    fam, label = winning
    return f"{fam}_{label}", fam, norm_fields(winning_fields), hit_labels

def family_depository(fam):
    return fam if fam in {"NSDL", "CDSL"} else np.nan

def exchange(cls, text):
    u = (str(cls) + " " + str(text)).upper()
    return "MCX" if "MCX" in u else ("BSE" if "BSE" in u else ("NSE" if "NSE" in u else np.nan))

def holdings(s):
    if pd.isna(s) or not clean_text(s):
        return [(np.nan, np.nan)]
    ans = []
    for p in re.split(r",\s*(?![^()]*\))", clean_text(s)):
        m = re.match(r"\s*(\d+(?:\.\d+)?)\s*[- ]\s*(.+?)\s*$", p)
        ans.append((to_num(m.group(1)) if m else np.nan, clean_text(m.group(2) if m else p)))
    return ans

def clean_security_name(sec):
    if pd.isna(sec) or not clean_text(sec):
        return np.nan
    s = clean_text(sec)
    s = re.sub(r"^(?:ordinary\s+shares?|equity\s+shares?|units?)\s*(?:of\s+|-\s*)", "", s, flags=re.I)
    s = re.sub(r"^\d+(?:\.\d+)?\s*-\s*", "", s)
    s = re.sub(r"\s+on\s+\d{2}[/-]?\d{2}[/-]?\d{2,4}\s*$", "", s, flags=re.I)
    s = re.sub(r"\s+on\s+\d{2}[A-Za-z]{3}\d{0,4}\s*$", "", s, flags=re.I)
    s = re.sub(r",?\s*Total\s+\d+\s+ISINs?.*$", "", s, flags=re.I)
    s = re.sub(r"\s*-\s*(?:CDSL|NSDL)\s*$", "", s, flags=re.I)
    s = s.strip(" ,.-")
    return s if s else np.nan

