# TABLE BUILDER
# ============================================================================
def build_tables(master):
    rows = {k: [] for k in TABLE_COLUMNS}

    for r in master.itertuples(index=False):
        f = r.fields
        cls = r.source_classifier
        c = canon(cls)
        fam = r.classifier_family
        text = r.sms_message
        b = r.broker_name
        ex = exchange(cls, text)
        base = core(r)
        dt = parse_date(
            val(f, "date", "date2", "close_date"),
            r.event_timestamp.normalize() if pd.notna(r.event_timestamp) else pd.NaT
        )
        dep = family_depository(fam)
        _placed_before = sum(
            len(v) for k, v in rows.items() if k != "16_advisory_promo_log"
        )

        # ================================================================
        # 01b broker association events
        # CHANGE: NSE_UCC_WELCOME is only added when a broker_name can be
        # determined.  Previously UCC welcome SMS with no discernible
        # broker still created rows (the UCC code is NOT a broker name).
        # ================================================================
        if any(x in c for x in [
            "UCCREGISTRATION", "UCCWELCOME", "BROKERFUNDBALANCE", "FUNDBALANCE",
            "ACCOUNTACTIVATED", "ACCOUNTOPENED", "ACCOUNTCLOSED",
            "ACCOUNTCLOSUREREQUEST", "ACCOUNTSUSPENDED",
            "ACCOUNTACTIVATION", "ACCOUNTCLOSURE", "INSTADEMATREGISTERED",
            "POAREGISTERED", "DDPIREGISTERED"
        ]):
            # CHANGE: skip UCC_WELCOME if broker_name is unknown
            if "UCCWELCOME" in c and pd.isna(b):
                pass  # do NOT add to 01b without a real broker
            else:
                is_closure_evt = any(x in c for x in ["CLOSURE", "ACCOUNTCLOSED"])
                is_activation_evt = any(x in c for x in ["ACCOUNTACTIVAT", "ACCOUNTOPENED", "ACTIVATION"])
                status = (
                    "closed" if is_closure_evt
                    else "suspended" if "ACCOUNTSUSPENDED" in c
                    else "active" if is_activation_evt
                    else "pending" if "REGISTRATION" in c
                    else "active"
                )
                add(
                    rows,
                    "01b_broker_association_events",
                    **base,
                    broker_name=b,
                    dp_name=val(f, "dp", "dp_name"),
                    exchange=ex,
                    ucc=val(f, "ucc"),
                    registration_date=dt if ("UCC" in c or "INSTA" in c) else pd.NaT,
                    kyc_complete_date=dt if any(x in c for x in ["DDPI", "POA"]) else pd.NaT,
                    account_activation_date=dt if is_activation_evt else pd.NaT,
                    account_closure_date=dt if is_closure_evt else pd.NaT,
                    latest_status=status,
                )

        # ================================================================
        # 02 share transactions ledger
        # CHANGE: added CREDITGENERAL for credits, added instrument_type
        # ================================================================
        share_type = None
        if any(x in c for x in ["PAYINDEBIT", "DEBITMISC", "DEBITSHORT", "DEBITBULK"]):
            share_type = "debit"
        elif any(x in c for x in ["CREDITIPOFPO", "CREDITGENERAL"]):  # CHANGE: credit
            share_type = "credit"
        elif "BLOCKED" in c:
            share_type = "early_payin" if "EARLY" in c else "blocked"

        if share_type:
            items = (
                holdings(val(f, "holdings"))
                if pd.notna(val(f, "holdings"))
                else [(to_num(val(f, "qty")), val(f, "security"))]
            )
            for q, sec in items:
                inst = detect_instrument_type(sec)    # CHANGE: ETF/EQ
                add(
                    rows,
                    "02_transactions_combined",
                    **base,
                    transaction_category="share_movement",
                    txn_date=dt,
                    exchange=ex,
                    broker_name=b,
                    depository=dep,
                    txn_type=share_type,
                    instrument_type=inst,              # CHANGE: added
                    security_name=sec,
                    security_isin=val(f, "isin"),
                    qty=q,
                    insufficient_qty=np.nan,
                    settlement_no=val(f, "settlement_no"),
                    amount=np.nan,
                    bank_account_mask=np.nan,
                    payout_type=np.nan,
                )

        # corporate actions
        corp_map = {
            "BONUSCREDIT": "bonus",
            "CREDITEDSCHEME": clean_text(val(f, "reason")).lower() if pd.notna(val(f, "reason")) else "scheme",
            "DEBITEDEXTINGUISHMENT": "extinguishment",
            "CONSOLIDATION": "consolidation",
        }
        corp_txn = None
        for k, v in corp_map.items():
            if k in c:
