def normalize_broker_name(name):
    if pd.isna(name) or not clean_text(name):
        return np.nan
    raw = clean_text(name)
    raw_u = raw.upper()
    for k, v in BROKERS:
        if k in raw_u:
            return v
    compact = re.sub(r"\s+", " ", raw).strip(" -,.")
    titled = " ".join(w.capitalize() if not w.isupper() else w for w in compact.split())
    return titled

def broker_from_sms(text, f):
    direct = val(f, "broker", "broker_name", "dp", "dp_name")
    direct_norm = normalize_broker_name(direct)
    if pd.notna(direct_norm):
        return direct_norm
    u = clean_text(text).upper()
    for k, v in BROKERS:
        if k in u:
            return v
    patterns = [
        r"with broker\s+([A-Z][A-Z0-9 .&\-]{2,})",
        r"with\s+([A-Z][A-Z0-9 .&\-]{2,})\s*-\s*DP ID",
        r"reported your Fund bal.*?(?:^|\s)([A-Z][A-Z0-9 .&\-]{2,})\s+(?:on|at)\s+",
        r"Dear Investor,\s*your (?:DP|stock broker)\s+(.+?)\s+has initiated",
        r"On\s+\d{2}/?\d{2}/?\d{2},\s*(.+?)\s+was registered as (?:Power of Attorney|Demat Debit and Pledge Instruction)",
        # CHANGE: broader broker extraction patterns
        r"Dear Client\s+(\S+),",
        r"(?:Regards|Team)\s*,?\s*([A-Z][A-Za-z ]+?)(?:\.|$)",
        r"(\S+(?:\s+\S+){0,3})\s+at EOD\s+\d",
    ]
    for pat in patterns:
        m = re.search(pat, u, re.I)
        if m:
            found = normalize_broker_name(m.group(1))
            if pd.notna(found):
                return found
    return np.nan

