# ============================================================================
# CHANGE: infer_mf_frequency -- kept from previous version
# ============================================================================
def infer_mf_frequency(mf):
    if mf.empty:
        return mf

    def _bucket(days: float) -> str:
        if days <=   2: return "daily"
        if days <=  10: return "weekly"
        if days <=  20: return "fortnightly"
        if days <=  45: return "monthly"
        if days <= 100: return "quarterly"
        if days <= 250: return "half_yearly"
        return "yearly"

    def _freq_from_dates(date_series, idx):
        dates = (
            pd.to_datetime(date_series.loc[idx], errors="coerce")
            .dropna()
            .sort_values()
            .drop_duplicates()
        )
        if len(dates) < 2:
            return None
        gaps = dates.diff().dropna().dt.days
        gaps = gaps[gaps > 0]
        return _bucket(float(gaps.median())) if not gaps.empty else None

    mf = mf.copy()
    mf["frequency"] = mf["frequency"].astype("object")

    # Pass 1: SIP-ID grouping
    has_sip_col = "sip_id" in mf.columns
    if has_sip_col and mf["sip_id"].notna().any():
        sip_df = mf[mf["sip_id"].notna()]
        for (cid, sid), idx in sip_df.groupby(["client_id", "sip_id"], dropna=False).groups.items():
            freq = _freq_from_dates(mf["due_date"], idx)
            if freq is not None:
                mf.loc[idx, "frequency"] = freq

    # Pass 2: fund-name / folio grouping (fallback)
    grp_fund = mf["fund_name"].fillna(
        mf["folio_number"] if "folio_number" in mf.columns else pd.Series(dtype=object)
    )
    basis = mf["due_date"].fillna(mf["event_timestamp"])
    for (cid, fund), idx in mf.groupby([mf["client_id"], grp_fund], dropna=False).groups.items():
        if pd.isna(fund):
            continue
        unset = mf.loc[idx, "frequency"].isna()
        target_idx = idx[unset]
        if len(target_idx) < 2:
            continue
        freq = _freq_from_dates(basis, target_idx)
        if freq is not None:
            mf.loc[target_idx, "frequency"] = freq
    return mf


# ============================================================================
# CHANGE: ensure_all_clients_in_broker_table
# After all tables are built, scan every table for (client_id, broker_name)
# pairs and guarantee each pair appears in table 01b.
# ============================================================================
def ensure_all_clients_in_broker_table(tables):
    """Scan every output table for (client_id, broker_name) pairs and add
    missing ones to 01b_broker_association_events with
    latest_status='inferred_from_activity'."""

    target_name = "01b_broker_association_events"
    t01b = tables[target_name]

    # 1. collect every (client_id, broker_name) from all tables
    all_pairs = set()
    for name, df in tables.items():
        if df.empty:
            continue
        if "client_id" in df.columns and "broker_name" in df.columns:
            sub = df[["client_id", "broker_name"]].dropna(subset=["client_id"])
            for _, row in sub.iterrows():
                cid = row["client_id"]
                bname = row["broker_name"]
                if pd.notna(cid):
                    # pair with broker (may be NaN -- we still want the client)
                    all_pairs.add((str(cid), bname if pd.notna(bname) else np.nan))

    # 2. Also collect bare client_ids (even if broker is unknown)
    all_client_ids = set()
    for name, df in tables.items():
        if df.empty or "client_id" not in df.columns:
            continue
        for cid in df["client_id"].dropna().unique():
            all_client_ids.add(str(cid))

    # 3. existing (client_id, broker_name) pairs in 01b
    existing_pairs = set()
    existing_clients = set()
    if not t01b.empty:
        for _, row in t01b[["client_id", "broker_name"]].iterrows():
            cid = row["client_id"]
            bname = row["broker_name"]
            if pd.notna(cid):
                existing_clients.add(str(cid))
                if pd.notna(bname):
                    existing_pairs.add((str(cid), str(bname)))
                else:
                    existing_pairs.add((str(cid), np.nan))

    # 4. find missing pairs
    new_rows = []
    cols = TABLE_COLUMNS[target_name]

    for cid, bname in all_pairs:
        if pd.notna(bname):
            if (str(cid), str(bname)) not in existing_pairs:
                row = {c: np.nan for c in cols}
                row["client_id"] = cid
                row["broker_name"] = bname
                row["latest_status"] = "inferred_from_activity"
                new_rows.append(row)
                existing_pairs.add((str(cid), str(bname)))
        else:
            # client exists with unknown broker -- only add if client totally absent
            if str(cid) not in existing_clients:
                row = {c: np.nan for c in cols}
                row["client_id"] = cid
                row["latest_status"] = "inferred_from_activity"
                new_rows.append(row)
                existing_clients.add(str(cid))

    # 5. also ensure bare clients (no broker anywhere) still appear
    for cid in all_client_ids:
        if cid not in existing_clients:
            row = {c: np.nan for c in cols}
            row["client_id"] = cid
            row["latest_status"] = "inferred_from_activity"
            new_rows.append(row)
            existing_clients.add(cid)

    if new_rows:
        new_df = pd.DataFrame(new_rows, columns=cols)
        tables[target_name] = pd.concat([t01b, new_df], ignore_index=True)

    return tables


# ============================================================================
# CHANGE: helper to decide SIP vs lumpsum from SMS text
# ============================================================================
_SIP_BODY_RE = re.compile(
    r"\bSIP\b|systematic\s+investment|recurring\s+(?:plan|investment)"
    r"|upcoming\s+(?:SIP|payment)|SIP\s+(?:set-?up|registration|due)"
    r"|XSIP|x-?sip|Auto-?pay.*?SIP",
    re.I,
)

def is_sip_from_text(cls, text):
    """Return True if classifier or SMS body indicates SIP (not lumpsum)."""
    if "SIP" in canon(cls):
        return True
    if _SIP_BODY_RE.search(str(text)):
        return True
    return False


