# ============================================================================
# PARALLEL CLASSIFICATION
# ============================================================================
_worker_rule_index = None

def _init_worker():
    global _worker_rule_index
    _worker_rule_index = build_rule_index(RULES)

def _classify_chunk(texts):
    global _worker_rule_index
    if _worker_rule_index is None:
        _worker_rule_index = build_rule_index(RULES)
    return [classify(t, _worker_rule_index) for t in texts]

def _chunked(seq, size):
    for i in range(0, len(seq), size):
        yield seq[i:i + size]

def classify_all(texts, rule_index, use_multiprocessing=True, chunk_size=CLASSIFY_CHUNK_SIZE):
    n = len(texts)
    workers = os.cpu_count() or 1
    if not use_multiprocessing or workers <= 1 or n < chunk_size * 2:
        return [classify(t, rule_index) for t in texts]
    chunks = list(_chunked(texts, chunk_size))
    results = []
    with ProcessPoolExecutor(max_workers=workers, initializer=_init_worker) as ex:
        for batch in ex.map(_classify_chunk, chunks):
            results.extend(batch)
    return results


# ============================================================================
# RUNNER
# ============================================================================
def run(input_csv, output_dir):
    if not RULES:
        raise ValueError("RULES is empty.")

    t_start = time.time()
    out = Path(output_dir)
    out.mkdir(parents=True, exist_ok=True)

    header = pd.read_csv(input_csv, nrows=0)
    stripped_to_raw = {str(c).strip(): c for c in header.columns}
    header.columns = list(stripped_to_raw.keys())
    client_raw_col = stripped_to_raw[pick_column(header, BASE_HINTS["client_id"])]
    raw = pd.read_csv(input_csv, low_memory=False, dtype={client_raw_col: "string"})
    raw.columns = [str(c).strip() for c in raw.columns]

    client = pick_column(raw, BASE_HINTS["client_id"])
    msg = pick_column(raw, BASE_HINTS["message"])
    sms_id = pick_column(raw, BASE_HINTS["sms_id"], False)
    ts = pick_column(raw, BASE_HINTS["event_time"], False)

    rule_index = build_rule_index(RULES)

    print(f"Classifying {len(raw):,} SMS messages ({os.cpu_count() or 1} CPU cores available)...")
    t0 = time.time()
    texts = [clean_text(v) for v in raw[msg].tolist()]
    classified = classify_all(texts, rule_index, use_multiprocessing=USE_MULTIPROCESSING)
    print(f"  classification: {time.time() - t0:.1f}s")

    def _clean_client_id(v):
        if pd.isna(v):
            return np.nan
        if isinstance(v, float) and v.is_integer():
            return str(int(v))
        s = str(v).strip()
        return s if s else np.nan

    client_ids = [_clean_client_id(v) for v in raw[client].tolist()]
    sms_ids = raw[sms_id].astype(str).tolist() if sms_id else [np.nan] * len(raw)
    timestamps = (
        pd.to_datetime(raw[ts], errors="coerce", utc=True).tolist() if ts else [pd.NaT] * len(raw)
    )

    rec = []
    for i in range(len(raw)):
        cls, fam, fields, hits = classified[i]
        rec.append({
            "client_id": client_ids[i],
            "source_sms_id": sms_ids[i],
            "event_timestamp": timestamps[i],
            "sms_message": texts[i],
            "source_classifier": cls,
            "classifier_family": fam,
            "rule_label": cls.split("_", 1)[1] if "_" in cls else "",
            "fields": fields,
            "all_classifier_hits": " | ".join(hits),
            "classifier_hit_count": len(hits),
        })

    master = pd.DataFrame(rec)
    if "event_timestamp" in master.columns:
        master["event_timestamp"] = pd.to_datetime(master["event_timestamp"]).dt.tz_localize(None)

    master["broker_name"] = [
        broker_from_sms(t, f) for t, f in zip(master["sms_message"], master["fields"])
    ]

    print("Building output tables...")
    t1 = time.time()
    tables = build_tables(master)
    print(f"  build_tables: {time.time() - t1:.1f}s")

    # CHANGE: ensure every (client_id, broker_name) pair from any table
    # appears in 01b_broker_association_events
    print("Ensuring all clients and brokers appear in table 01b...")
    tables = ensure_all_clients_in_broker_table(tables)

    # sort 01b
    if not tables["01b_broker_association_events"].empty:
        tables["01b_broker_association_events"] = (
            tables["01b_broker_association_events"]
            .sort_values(
                ["client_id", "broker_name", "event_timestamp"],
                na_position="last",
            )
            .reset_index(drop=True)
        )

    # SIP frequency inference
    tables["08_mutual_fund_activity"] = infer_mf_frequency(tables["08_mutual_fund_activity"])

    # write outputs
    for name, t in tables.items():
        t.to_csv(out / f"{name}.csv", index=False)

    master.drop(columns="fields").to_csv(out / "00_enriched_master.csv", index=False)
    row_summary = pd.DataFrame([{"table": k, "rows": len(v)} for k, v in tables.items()])
    row_summary.to_csv(out / "table_row_summary.csv", index=False)

    master.loc[
        master.classifier_hit_count > 1,
        ["client_id", "source_sms_id", "sms_message", "source_classifier", "all_classifier_hits"]
    ].to_csv(out / "qa_multi_rule_hits.csv", index=False)

    master.loc[
        master.source_classifier.eq("UNCATEGORISED"),
        ["client_id", "source_sms_id", "sms_message"]
    ].to_csv(out / "qa_uncategorised.csv", index=False)

    with pd.ExcelWriter(out / "sms_warehouse_tables.xlsx", engine="openpyxl",
                        datetime_format="yyyy-mm-dd hh:mm:ss") as w:
        for name, t in tables.items():
            t.to_excel(w, sheet_name=name[:31], index=False)
        row_summary.to_excel(w, sheet_name="row_summary", index=False)

    print(f"Created {len(tables)} tables in: {out.resolve()}")
    print(f"Total time: {time.time() - t_start:.1f}s")
    return tables, master


