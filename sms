    "HDFCNIFETF", "HDFCSENETF", "UTINIFTETF",
]
_ETF_RE = re.compile("|".join(_ETF_KEYWORDS), re.I)

def detect_instrument_type(security_name):
    """Classify a security as ETF or EQ based on name heuristics."""
    if pd.isna(security_name) or not clean_text(security_name):
        return np.nan
    return "ETF" if _ETF_RE.search(str(security_name)) else "EQ"

def add(rows, table, **kw):
    rows[table].append(kw)

