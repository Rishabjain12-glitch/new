def extract_name(selected_text):
    selected_text = selected_text.replace("Â", " ").strip()
    if "|" in selected_text:
        return selected_text.split("|", 1)[1].strip().title()
    return selected_text.title()

def scrape_first_suggestion(codes):
    results = []

    with sync_playwright() as p:
        browser = p.chromium.launch(headless=False)
        page = browser.new_page(viewport={"width": 1600, "height": 1200})
        page.goto("https://www.bseindia.com/members/membershipdirectory", wait_until="domcontentloaded", timeout=60000)
        page.wait_for_timeout(4000)

        search_box = page.get_by_placeholder("Enter Member Name")
        search_box.wait_for(timeout=30000)

        for code in codes:
            try:
                search_box.click()
                search_box.fill("")
                page.wait_for_timeout(300)

                search_box.press_sequentially(code, delay=120)
                page.wait_for_timeout(1500)

                page.keyboard.press("ArrowDown")
                page.wait_for_timeout(300)
                page.keyboard.press("Enter")
                page.wait_for_timeout(1000)

                selected_value = search_box.input_value()
                broker_name = extract_name(selected_value)

                results.append({
                    "Member Code": code,
                    "Broker Name": broker_name
                })

                search_box.fill("")
                page.wait_for_timeout(500)

            except Exception as e:
                results.append({
                    "Member Code": code,
                    "Broker Name": f"ERROR: {str(e)}"
                })

        browser.close()

    return results

if __name__ == "__main__":
    data = scrape_first_suggestion(member_codes)
    df = pd.DataFrame(data)
    df.to_excel("bse_member_code_first_suggestion.xlsx", index=False)
    print(df)
